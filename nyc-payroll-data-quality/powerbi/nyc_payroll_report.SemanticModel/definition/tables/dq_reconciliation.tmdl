	partition dq_reconciliation = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dq_reconciliation.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"fiscal_year", Int64.Type}, {"raw_rows", Int64.Type}, {"exact_duplicates_removed", Int64.Type}, {"curated_rows", Int64.Type}, {"rows_reconcile", type logical}}, "en-US")
				in
					Typed

